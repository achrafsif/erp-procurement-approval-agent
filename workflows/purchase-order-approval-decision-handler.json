    {
      "parameters": {
        "jsCode": "const query = $json.query || $json;\n\nconst approvalId = query.approval_id;\nconst decision = String(query.decision || '').toLowerCase();\nconst decisionBy = query.decision_by || 'Procurement Manager';\n\nif (!approvalId) {\n  throw new Error('Missing approval_id');\n}\n\nif (!['approved', 'rejected'].includes(decision)) {\n  throw new Error('Decision must be approved or rejected');\n}\n\nreturn [{\n  json: {\n    approval_id: approvalId,\n    decision,\n    decision_status:\n      decision === 'approved' ? 'Approved' : 'Rejected',\n    decision_by: decisionBy,\n    decided_at: new Date().toISOString(),\n    action_result:\n      decision === 'approved'\n        ? 'Purchase order escalation approved'\n        : 'Purchase order request rejected'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
